REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
IdpClientSecret=supersecret
DATAGEMS_POSTGRES_HOST=localhost
DATAGEMS_POSTGRES_PORT=5432

ENABLE_AUTH=false

# SCAYLE model service: dataset summaries and MathE document OCR.
