REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
IdpClientSecret=supersecret
DATAGEMS_POSTGRES_HOST=localhost
DATAGEMS_POSTGRES_PORT=5432

AWS_ACCESS_KEY=some_access_key
AWS_SECRET_KEY=some_secret_key
ENABLE_AUTH=false

# MathE document OCR backend: "scayle" (default) or "bedrock".
# "bedrock" uses the AWS_* settings above; "scayle" uses the SCAYLE_* settings.
MATHE_OCR_BACKEND=scayle
SCAYLE_BASE_URL=https://scayle.example.org/api
SCAYLE_USERNAME=some_username
SCAYLE_PASSWORD=some_password
SCAYLE_VERIFY_SSL=false

# Use and refresh Qdrant-backed MathE question rankings by default.
MATHE_PRECOMPUTED_RANKINGS=true
